# Per-region reverse proxy with automatic Let's Encrypt for PUBLIC_HOST.
# Real cert (not `tls internal`) so the iOS CometChat SDK — which pins HTTPS
# for overridden hosts and will not accept a self-signed cert — connects.
{
  # No HTTP/3. The only reason it was on is that it is Caddy's default, and it
  # costs us: Caddy advertises it with an Alt-Svc header added to EVERY
  # response — including the 101 that completes a WebSocket handshake, where a
  # strict client has no business seeing it. `header_down -Alt-Svc` cannot
  # remove it, because Caddy cannot rewrite a response whose connection it has
  # already hijacked for the upgrade. Turning the protocol off is the only way
  # to keep the handshake response clean.
  servers {
    protocols h1 h2
  }
}

PUBLIC_HOST_PLACEHOLDER {
  # Static web client, served by this region. Everything else proxies to the
  # app. Listed first so /app doesn't fall through to the catch-all.
  handle /app* {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }

  reverse_proxy /v3/* 127.0.0.1:4000
  reverse_proxy /v3.0/* 127.0.0.1:4000
  reverse_proxy /v1/* 127.0.0.1:4000
  reverse_proxy /extensions/* 127.0.0.1:4000
  reverse_proxy /media/* 127.0.0.1:4000
  reverse_proxy /ws 127.0.0.1:4000
  reverse_proxy /socket 127.0.0.1:4000
  reverse_proxy /health 127.0.0.1:4000
  # Voice call instructions. Carriers fetch this when a call connects, so it
  # must be reachable without a credential — see the route for why that is safe.
  reverse_proxy /texml 127.0.0.1:4000
  # Inbound webhooks: Sentry, GCP alerting, CI, forwarded help@ mail. The
  # token in the query string is the credential, checked by the app.
  reverse_proxy /hooks/* 127.0.0.1:4000
  reverse_proxy / 127.0.0.1:4000
}
